# =============================================================================
# FIAP X — variáveis de ambiente
# Copie para .env e preencha os valores:   cp .env.example .env
# NUNCA versione o arquivo .env.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=fiapx

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=fiapx
RABBITMQ_DEFAULT_PASS=TROQUE_ESTA_SENHA

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=TROQUE_ESTA_ACCESS_KEY
MINIO_ROOT_PASSWORD=TROQUE_ESTA_SECRET_KEY
MINIO_BUCKET=videos

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_ESTE_SEGREDO_COM_MINIMO_32_CARACTERES_AQUI
JWT_EXPIRATION_HOURS=24

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
RATE_LIMIT_RPS=100

# ── Worker ────────────────────────────────────────────────────────────────────
QUEUE_NAME=video.upload
NOTIFICATION_QUEUE=notification
PREFETCH_COUNT=5
MAX_RETRIES=3

# ── Notificação SMTP (opcional — log mode se vazio) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fiapx.com
