# =============================================================================
# FIAP X — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar:
#   cp .env.example .env
# NUNCA versione o arquivo .env.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=fiapx

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=fiapx
RABBITMQ_DEFAULT_PASS=TROQUE_ESTA_SENHA

# ---- MinIO ----
MINIO_ROOT_USER=TROQUE_ESTA_ACCESS_KEY
MINIO_ROOT_PASSWORD=TROQUE_ESTA_SECRET_KEY

# ---- API Gateway ----
API_PORT=8080
JWT_SECRET=TROQUE_ESTE_SEGREDO_MINIMO_32_CHARS
JWT_EXPIRATION_HOURS=24
QUEUE_NAME=video.process
MINIO_BUCKET=videos

# ---- Worker ----
PREFETCH_COUNT=5

# ---- Strings de conexão (montadas a partir das variáveis acima) ----
# São referenciadas diretamente no docker-compose; não é necessário alterar.
# DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
# MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
# MINIO_USE_SSL=false
