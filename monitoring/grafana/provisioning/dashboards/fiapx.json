{
  "uid": "fiapx-main",
  "title": "FIAP X — Monitoramento",
  "description": "Métricas do sistema de processamento de vídeos FIAP X",
  "tags": ["fiapx"],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests/s — API Gateway",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum by (path) (rate(gateway_http_requests_total[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Taxa de Erros 5xx — Gateway",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" },
          "custom": { "lineWidth": 2 },
          "unit": "percentunit",
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(gateway_http_requests_total[1m]))",
          "legendFormat": "Erros 5xx",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latência p50 / p95 / p99 — Gateway",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gateway_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fila RabbitMQ — video.upload",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "#FF9830", "mode": "fixed" }, "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=\"video.upload\"}",
          "legendFormat": "Mensagens na fila",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Vídeos Concluídos",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#73BF69", "mode": "fixed" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(worker_videos_processed_total{status=\"done\"}) or vector(0)",
          "legendFormat": "Concluídos",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Vídeos com Erro",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" },
          "thresholds": { "steps": [{ "color": "red", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(worker_videos_processed_total{status=\"error\"}) or vector(0)",
          "legendFormat": "Erros",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Throughput do Worker (vídeos/min)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#5794F2", "mode": "fixed" },
          "unit": "short",
          "decimals": 2
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(worker_videos_processed_total[1m])) * 60",
          "legendFormat": "vídeos/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Consumers RabbitMQ",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "#B877D9", "mode": "fixed" } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_consumers{queue=\"video.upload\"}) or vector(0)",
          "legendFormat": "Workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Duração de Processamento — Worker",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(worker_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(worker_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Goroutines por Serviço",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ]
}
