# ATENÇÃO: Este arquivo é um TEMPLATE.
# Copie para secrets.yaml, preencha os valores em base64 e NUNCA versione o arquivo real.
#   cp k8s/secrets.yaml.example k8s/secrets.yaml
# Codificar em base64: echo -n "valor" | base64
#
# secrets.yaml está no .gitignore.

apiVersion: v1
kind: Secret
metadata:
  name: fiapx-secrets
  namespace: fiapx
type: Opaque
data:
  # echo -n "SUA_SENHA_POSTGRES" | base64
  postgres-password: TROQUE_BASE64

  # echo -n "SUA_SENHA_RABBITMQ" | base64
  rabbitmq-password: TROQUE_BASE64

  # echo -n "SUA_ACCESS_KEY_MINIO" | base64
  minio-access-key: TROQUE_BASE64

  # echo -n "SUA_SECRET_KEY_MINIO" | base64
  minio-secret-key: TROQUE_BASE64

  # echo -n "SEU_JWT_SECRET_MINIMO_32_CHARS" | base64
  jwt-secret: TROQUE_BASE64
